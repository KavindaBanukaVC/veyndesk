{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyndesk",
  "version": "0.5.0",
  "identifier": "app.velodesk.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veyndesk",
        "width": 880,
        "height": 600,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Veyndesk contributors",
    "shortDescription": "Open-source remote desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "category": "Utility",
    "longDescription": "Free, open-source remote desktop. Connect to any computer with just an ID and password.",
    "homepage": "https://veyndesk.github.io",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "mainBinaryName": "Veyndesk"
}